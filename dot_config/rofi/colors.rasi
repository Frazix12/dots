* {
    primary: #ffb2b9;
    primary-fixed: #ffdadc;
    primary-fixed-dim: #ffb2b9;
    on-primary: #561d26;
    on-primary-fixed: #3b0712;
    on-primary-fixed-variant: #72333b;
    primary-container: #72333b;
    on-primary-container: #ffdadc;
    secondary: #e5bdbf;
    secondary-fixed: #ffdadc;
    secondary-fixed-dim: #e5bdbf;
    on-secondary: #43292c;
    on-secondary-fixed: #2c1518;
    on-secondary-fixed-variant: #5c3f42;
    secondary-container: #5c3f42;
    on-secondary-container: #ffdadc;
    tertiary: #e8c08e;
    tertiary-fixed: #ffddb6;
    tertiary-fixed-dim: #e8c08e;
    on-tertiary: #442b06;
    on-tertiary-fixed: #2a1800;
    on-tertiary-fixed-variant: #5d411b;
    tertiary-container: #5d411b;
    on-tertiary-container: #ffddb6;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #1a1112;
    on-surface: #f0dedf;
    on-surface-variant: #d7c1c2;
    outline: #9f8c8d;
    outline-variant: #524344;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #f0dedf;
    inverse-on-surface: #382e2f;
    inverse-primary: #8f4952;
    surface-dim: #1a1112;
    surface-bright: #413737;
    surface-container-lowest: #140c0d;
    surface-container-low: #22191a;
    surface-container: #271d1e;
    surface-container-high: #312828;
    surface-container-highest: #3d3233;
}

/* ROUNDED THEME FOR ROFI */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    bg0:    #2121219f;
    bg1:    #2A2A2A;
    bg2:    #3D3D3D80;
    bg3:    #ffb2b9;
    fg0:    #E6E6E6;
    fg1:    #FFFFFF;
    fg2:    #969696;
    fg3:    #3D3D3D;

    border: #81A1C100;
    background: @bg0;
    textcolor: #e0def4;
    accent1: #cc241d;
    accent2: #98971a;
    accent3: #d79921;
    accent4: #458588;
    selection: @on-secondary;
    selectionborder: @bg3;
    myhigh: bold #c4a7e7;
    searchcolor: #e0def499;
    powermenuselect: @bg3;
    nul: #00000000;
    borderradius: 20px;

    borderradiuselement: 9px;
}
